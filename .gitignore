### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

### SwiftPackageManager ###
Packages
.build/
xcuserdata
DerivedData/
*.xcodeproj


### Vim ###
# Swap
[._]*.s[a-v][a-z]
!*.svg  # comment out if you don't need vector files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

### Xcode ###
## User settings
xcuserdata/

## Xcode 8 and earlier
*.xcscmblueprint
*.xccheckout

### Xcode Patch ###
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/xcshareddata/WorkspaceSettings.xcsettings

# End of https://www.toptal.com/developers/gitignore/api/macos,vim,xcode,swiftpackagemanager,visualstudiocode
# Code coverage (swift test --enable-code-coverage)
*.profraw
*.profdata

# SwiftPM-generated workspace metadata
.swiftpm/xcode/package.xcworkspace/

# Auto-generated SwiftPM Xcode integration files
.swiftpm/xcode/xcshareddata/xcschemes/

# Linux build path used by scripts/test-linux.sh
.build-linux/

# Linux build path used by Fuzz/run-fuzz.sh (the in-container fuzz build).
.build-fuzz/
.build-fuzz-probe/

# Stray libFuzzer artifacts. run-fuzz.sh routes these into
# Fuzz/crashers/<target>/, but a manual fuzzer invocation can drop them in the
# cwd; never commit them (a real crasher gets triaged, not committed).
crash-*
leak-*
timeout-*
oom-*

# Xcode-style build/ dir (different from SwiftPM's .build/). Some IDE
# configurations and `xcodebuild` invocations drop intermediates here.
build/

# libFuzzer-grown corpus entries (run-fuzz.sh grows the corpus in place).
# Keep the .gitkeep placeholders and the committed XML seed; ignore the rest.
Fuzz/corpus/*/*
!Fuzz/corpus/*/.gitkeep
!Fuzz/corpus/xml/seed-fixture.xml
